---
import BaseHead from "../components/BaseHead.astro";
import "../styles/globals.css";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Page not found — Jess Daniel"
      description="The page you're looking for doesn't exist."
    />
  </head>
  <body class="relative min-h-screen overflow-x-hidden">
    <div class="page-bg pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

    <main
      class="mx-auto flex min-h-screen w-full max-w-2xl flex-col justify-center gap-6 px-6 py-16 sm:px-8"
    >
      <p
        class="font-sans text-sm font-semibold tracking-[0.16em] text-accent uppercase"
      >
        404
      </p>
      <h1
        class="font-display text-4xl font-normal tracking-[-0.01em] text-ink sm:text-5xl"
      >
        Page not found
      </h1>
      <p class="max-w-md font-sans text-lg text-muted">
        That page doesn't exist. Head back home to learn more about Jess and his
        companies.
      </p>
      <p>
        <a
          href="/"
          class="font-sans text-base font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
        >
          Back home
        </a>
      </p>
    </main>
  </body>
</html>
